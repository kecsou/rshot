{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rshot",
  "version": "0.1.0",
  "identifier": "io.github.kecsou.rshot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' blob: data:",
        "media-src": "'self' blob: http://127.0.0.1:*",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "publisher": "kecsou",
    "category": "Utility",
    "shortDescription": "Screenshots whose path lands on your clipboard",
    "longDescription": "rshot replaces the system screenshot tool, shortcuts included. Every capture puts its absolute file path on the clipboard next to the file and the image, so a terminal or an AI agent gets a path and a chat app gets the picture. It also records the screen to MP4, with an optional microphone, and trims recordings.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "sounds/shutter.wav": "sounds/shutter.wav" },
    "linux": {
      "deb": {
        "depends": ["libpipewire-0.3-0t64 | libpipewire-0.3-0", "libgbm1"],
        "recommends": ["gstreamer1.0-libav"],
        "preRemoveScript": "deb/prerm.sh",
        "files": { "/usr/share/doc/rshot/copyright": "deb/copyright" }
      },
      "rpm": {
        "depends": ["pipewire-libs", "mesa-libgbm"],
        "recommends": ["gstreamer1-plugin-openh264"],
        "preRemoveScript": "deb/prerm.sh"
      },
      "appimage": { "bundleMediaFramework": true }
    }
  }
}
